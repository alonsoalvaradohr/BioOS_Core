{
  "name": "bioos-core",
  "version": "8.10.0",
  "private": true,
  "description": "Kernel cognitivo y canal de ingesta BioOS sobre Google Apps Script.",
  "scripts": {
    "check": "node scripts/validate.mjs",
    "audit": "node scripts/audit-state.mjs",
    "test": "node --test apps-script/qa/*.node.test.js",
    "verify": "npm run check && npm test",
    "deploy": "npm run check && node scripts/deploy-gas.mjs",
    "test:e2e": "node scripts/black-box-test.mjs",
    "clasp:status": "clasp status",
    "harness": "node scripts/bioos-harness.mjs",
    "ticket": "node scripts/bioos-harness.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
