# BioOS Core — Configuration Template (.env.example)
# Copia este archivo a .env para entornos locales o configura estas claves en
# Google Apps Script (Project Settings > Script Properties).

# === TELEGRAM BOT & WEBHOOK CREDENTIALS ===
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
TELEGRAM_SECRET_TOKEN="YOUR_TELEGRAM_SECRET_TOKEN"

# === GEMINI AI LLM GATEWAY ===
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# === DATABASE & QUEUE REPOSITORY (SPREADSHEET) ===
BIOOS_DB_ID=""
BIOOS_DB_NAME="BioOS_DB"
BIOOS_QUEUE_MAX_ROWS=1000

# === SENSORS & EXTERNAL PROVIDERS ===
MOBVOI_API_ENDPOINT=""
MOBVOI_API_TOKEN=""
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""

# === GOVERNANCE & APPROVAL TOKENS ===
META_EVOLVE_APPROVAL_TOKEN="YOUR_MIN_24_CHAR_APPROVAL_TOKEN"
OPS_APPROVAL_TOKEN="YOUR_OPS_APPROVAL_TOKEN"
